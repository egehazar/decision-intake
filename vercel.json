{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{src/**,bundles/**}",
      "excludeFiles": "{results/**,experiments/**,tests/**,data/**,adapters/**,bundles/benefits_v2_1.npz,bundles/guards_2026_v2_1.json,bundles/guards_2026_d32.json}"
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/index?route=mcp"
    },
    {
      "source": "/healthz",
      "destination": "/api/index?route=healthz"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index?route=openapi.json"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/index?route=v1/:path*"
    },
    {
      "source": "/embed",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!embed$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        }
      ]
    },
    {
      "source": "/embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors https: http://localhost:* http://127.0.0.1:*; base-uri 'none'; form-action 'none'"
        }
      ]
    }
  ]
}
